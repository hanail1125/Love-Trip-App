{
  "extends": ["react-app", "react-app/jest", "plugin:prettier/recommended"],
  "plugins": ["prettier"],
  "ignorePatterns": ["**/dist/**", "**/*.min.js"],
  "rules": {
    "prettier/prettier": [
      "off",
      {
        "endOfLine": "lf",
        "semi": true,
        "singleQuote": true,
        "trailingComma": "none"
      }
    ],
    "@typescript-eslint/no-unused-vars": "off",
    "no-unused-vars": "off",
    "comma-dangle": "off",
    "func-call-spacing": ["error", "never"],
    "semi": "off",
    "@typescript-eslint/semi": ["error", "always"]
  }
}
